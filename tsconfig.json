{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "baseUrl": ".", // should remove when panda compatible with Typescript v6
    "paths": {
      "~/*": ["src/*"] // should change "src/*" -> "./src/*" when panda compatible with Typescript v6
    },
    "ignoreDeprecations": "6.0", // should remove when panda compatible with Typescript v6

    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  }
}
